# Itqan Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://itqan:itqan_dev_password@localhost:5432/itqan?schema=public
POSTGRES_PASSWORD=itqan_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=itqan_admin
MINIO_SECRET_KEY=itqan_secret_key
MINIO_BUCKET=itqan-audio

# JWT
JWT_SECRET=generate_secure_random_32_bytes_base64
JWT_EXPIRY=30d
JWT_REFRESH_EXPIRY=90d

# Tarteel API (Voice Recognition)
TARTEEL_API_KEY=your_tarteel_api_key_here
TARTEEL_API_URL=https://api.tarteel.ai

# WhatsApp Business API (360dialog)
WHATSAPP_API_URL=https://waba.360dialog.io
WHATSAPP_API_KEY=your_360dialog_api_key
WHATSAPP_TEMPLATE_NAMESPACE=your_template_namespace

# Fawry Payment
FAWRY_MERCHANT_CODE=your_merchant_code
FAWRY_SECRET_KEY=your_secret_key
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=itqan_grafana
SENTRY_DSN=your_sentry_dsn_here

# Email (SendGrid/Postmark fallback)
SENDGRID_API_KEY=your_sendgrid_key
FROM_EMAIL=noreply@itqan.link
FROM_NAME=إتقان

# Feature Flags
ENABLE_ASR=false
ENABLE_LIVE_HALAQA=false
ENABLE_MUTASHABIHAT=true
ENABLE_FAMILY_PORTAL=false

# Localization
DEFAULT_LOCALE=ar-EG
DEFAULT_TIMEZONE=Africa/Cairo
HIJRI_OFFSET=0