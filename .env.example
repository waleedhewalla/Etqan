# Itqan Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://itqan:itqan_dev_password@localhost:5432/itqan
POSTGRES_PASSWORD=itqan_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=itqan_admin
MINIO_SECRET_KEY=itqan_secret_key
MINIO_BUCKET=itqan-audio
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
# Recordings are deleted this many hours after the teacher reviews them (the privacy page says 24),
# or after this many days if nobody reviews them. Scores, notes and flags are kept.
AUDIO_RETENTION_HOURS=24
AUDIO_UNREVIEWED_MAX_DAYS=30
# 's3' stores recordings in MinIO/S3 (the bucket is created on first use);
# 'memory' keeps them in the API process only, for quick local trials (lost on restart).
STORAGE_DRIVER=s3

# JWT
JWT_SECRET=generate_secure_random_32_bytes_base64
JWT_EXPIRY=30d
JWT_REFRESH_EXPIRY=90d

# Recitation checking (optional). Teacher-only review works without any of this.
#   ASR_PROVIDER=none               off (default)
#   ASR_PROVIDER=demo               fakes a result so the screens can be tried (refused in production)
#   ASR_PROVIDER=openai-compatible  any service with POST {ASR_API_URL}/audio/transcriptions
# It also needs ENABLE_ASR=true, the institution's switch turned on, and each student's consent.
ASR_PROVIDER=none
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1

# WhatsApp Business API (360dialog)
# Leave WHATSAPP_API_KEY empty in development: login codes and absence alerts
# are then written to the API log instead of being sent.
WHATSAPP_API_URL=https://waba-v2.360dialog.io
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_NAMESPACE=
# Approved template names (Arabic). OTP: one {{1}} code param plus a copy-code button.
# Absence alert body params: {{1}} student, {{2}} halaqa, {{3}} day in Arabic (e.g. الخميس ٣٠ أكتوبر).
WHATSAPP_TEMPLATE_OTP=itqan_otp
WHATSAPP_TEMPLATE_ABSENCE=itqan_absence_alert
WHATSAPP_TEMPLATE_LANGUAGE=ar

# Fawry Payment
FAWRY_MERCHANT_CODE=your_merchant_code
FAWRY_SECRET_KEY=your_secret_key
FAWRY_BASE_URL=https://atfawry.fawrystaging.com

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=itqan_grafana
SENTRY_DSN=your_sentry_dsn_here

# Web app address used in magic links
FRONTEND_URL=http://localhost:9050

# Email (SendGrid/Postmark fallback)
# Leave empty in development: magic links are written to the API log.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@itqan.link
FROM_NAME=إتقان

# Feature Flags
ENABLE_ASR=false
ENABLE_LIVE_HALAQA=false
ENABLE_MUTASHABIHAT=true
ENABLE_FAMILY_PORTAL=false

# Localization
DEFAULT_LOCALE=ar-EG
DEFAULT_TIMEZONE=Africa/Cairo
HIJRI_OFFSET=0

# Quran text loader (pnpm --filter @itqan/core db:seed-quran).
# QURAN_TEXT_PATH (a local quran.json) wins over QURAN_TEXT_URL (downloaded).
# Source and licence (CC BY-SA 4.0): see /credits in the app and TESTING.md.
QURAN_TEXT_PATH=
QURAN_TEXT_URL=https://cdn.jsdelivr.net/npm/quran-json@3.1.2/dist/quran.json
