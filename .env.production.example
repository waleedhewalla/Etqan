# Copy to .env next to compose.prod.yml and fill in. NEVER commit the filled-in file.
# Generate secrets with:  openssl rand -base64 36 | tr -d '\n'   (use -hex for the database password)

# ── Where it is served ──
# Two names that already point (DNS A/AAAA records) at this server. HTTPS certificates are fetched automatically.
APP_DOMAIN=app.example.org
API_DOMAIN=api.example.org
ACME_EMAIL=you@example.org

# ── Secrets (all required) ──
POSTGRES_PASSWORD=
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Audio storage defaults to the MinIO container in this stack. To use a managed S3 service instead, set these to its
# endpoint (host:port, no scheme), region and bucket, put its access key/secret in MINIO_ACCESS_KEY / MINIO_SECRET_KEY, and
# start with `--scale minio=0`. The bucket is created on first use if the key may create buckets; otherwise create it first.
#MINIO_ENDPOINT=s3.eu-central-1.amazonaws.com
#MINIO_USE_SSL=true
#MINIO_REGION=eu-central-1
#MINIO_BUCKET=itqan-audio

# ── Sign-in messages (needed for anyone to sign in) ──
# Staff get a magic link by email (SendGrid); students get a code on WhatsApp (360dialog).
# Without these the API refuses to send codes in production, so nobody can sign in.
SENDGRID_API_KEY=
FROM_EMAIL=noreply@example.org
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_NAMESPACE=

# ── Plan limits: 'warn' only reports them; 'block' refuses new students/halaqat when an institution is full or expired ──
PLAN_ENFORCEMENT=warn

# ── Recordings kept this long after the teacher reviews them (the privacy page says 24), or this many days if never reviewed ──
AUDIO_RETENTION_HOURS=24
AUDIO_UNREVIEWED_MAX_DAYS=30

# ── Automatic first check of recitations (optional; off by default). See TESTING.md before turning on:
#    audio is sent to the service named here, which needs your data-processing terms with them. ──
ENABLE_ASR=false
ASR_PROVIDER=none
ASR_API_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
